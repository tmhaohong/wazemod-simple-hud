# LCDWIKI ES3N28P N16R8, 2.8-inch ILI9341V SPI LCD.
CONFIG_WAZE_HUD_LCD_ILI9341=y
CONFIG_WAZE_HUD_LCD_SCLK=12
CONFIG_WAZE_HUD_LCD_MOSI=11
CONFIG_WAZE_HUD_LCD_CS=10
CONFIG_WAZE_HUD_LCD_DC=46
CONFIG_WAZE_HUD_LCD_RESET=-1
CONFIG_WAZE_HUD_LCD_BACKLIGHT=45
CONFIG_WAZE_HUD_LCD_BACKLIGHT_ACTIVE_LOW=n
CONFIG_WAZE_HUD_LCD_BGR=y
CONFIG_WAZE_HUD_LCD_INVERT=y
CONFIG_WAZE_HUD_TDISPLAY_PERIPHERALS=n
CONFIG_WAZE_HUD_MOCK_MODE=n
